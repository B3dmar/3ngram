{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "rangeStrategy": "pin",
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] },
  "packageRules": [
    {
      "description": "Cooldown applies hardest to npm — active worm era (research/05)",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "GitHub Actions: pin to digest, never tags",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Automerge safe updates: devDependencies patch/minor (still behind the 7-day npm cooldown above)",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "description": "Automerge digest pins (SHA-pinned GitHub Actions digest bumps)",
      "matchUpdateTypes": ["digest", "pinDigest"],
      "automerge": true
    }
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "branchConcurrentLimit": 5,
  "labels": ["area:ops"]
}
