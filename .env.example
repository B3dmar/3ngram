# 3ngram environment template — copy to .env and fill in. Never commit real values.
# .env is gitignored; this file documents every key the repo reads.
# Deploying (Railway + Neon staging/prod): see docs/operate.mdx.

# ── Neon (tooling only — neonctl branch-per-PR CI loop; NOT read by the runtime)
NEON_API_KEY=
NEON_PROJECT_ID=

# ── Database (packages/db)
# Pooled URL for runtime, unpooled (owner) URL for migrations only.
# Defaults below match the local Docker stack (docker-compose.yml): owner role
# `postgres`/`3ngram-dev`, runtime role `app_user`/`app-user-dev`, published
# port 54320. They let the self-host quickstart's `pnpm seed` work as-is from
# the host. Replace with your Neon URLs for cloud deploys.
#
# Coupling: compose derives the server's DATABASE_URL from APP_USER_PASSWORD,
# but the host-run `pnpm seed` reads the literal DATABASE_URL below. If you
# change the app_user password, set it in BOTH APP_USER_PASSWORD *and* the
# password segment of DATABASE_URL — overriding one alone breaks `pnpm seed`.
DATABASE_URL=postgresql://app_user:app-user-dev@localhost:54320/ngram
DATABASE_URL_UNPOOLED=postgresql://postgres:3ngram-dev@localhost:54320/ngram
# APP_USER_PASSWORD: local/tooling only — docker-compose sets the app_user
# Postgres password from it. The runtime server never reads it directly.
APP_USER_PASSWORD=app-user-dev

# Integration-test safety guard (AGENTS.md; packages/db/test/integration/ephemeral-guard.ts).
# The destructive integration suite (global TRUNCATE) runs against the local Docker
# stack with NO extra config — localhost/127.0.0.1/::1 are auto-trusted. The flag
# I_AM_AN_EPHEMERAL_DB=1 is a CI-only escape hatch to mark a REMOTE throwaway DB (e.g.
# a disposable remote branch) as safe to truncate. Current CI uses local pgvector
# service containers and does not need this override. Do NOT
# put it in .env: once set, the guard short-circuits the host check, so a later
# accidental prod DATABASE_URL would no longer be blocked. (No assignable key here by
# design — it is never meant to live in a .env file.)

# ── LLM / embedding gateway (packages/llm)
# The four provider keys below are RESERVED for Phase 1B multi-LLM routing (deferred) — no current code reads them; leave blank. Today only the embedding
# gateway pair is wired: set LLM_GATEWAY_URL + LLM_GATEWAY_API_KEY together to enable
# embeddings (either one unset = embeddings off, search returns "not configured").
OPENAI_API_KEY=
VOYAGEAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=

# ── Server (apps/server)
PORT=3000

# ── OAuth Authorization Server (apps/server — issue #165)
# BASE_URL: the deployment's public origin. Becomes the OAuth issuer (normalized
# via new URL().href, trailing slash) and the RFC 8707 resource id (BASE_URL+mcp);
# the minted token `iss`/`aud` must match it exactly. REQUIRED when NODE_ENV=production.
BASE_URL=
# OAUTH_JWKS: JSON array of RS256 PRIVATE signing keys (the first is the current
# signer; others stay valid for rotation). Each key needs kty=RSA, alg=RS256, kid,
# and the private fields. REQUIRED when NODE_ENV=production. Generate one with:
#   node -e 'const{generateKeyPairSync,randomUUID}=require("crypto");const{privateKey}=generateKeyPairSync("rsa",{modulusLength:2048});const j=privateKey.export({format:"jwk"});j.kid="key-"+randomUUID().slice(0,8);j.alg="RS256";j.use="sig";console.log(JSON.stringify([j]))'
OAUTH_JWKS=

# ── Auth email link origin (apps/server — issues #267, #349)
# WEB_APP_URL: public origin of the 3ngram dashboard (the separate app that SERVES
# /reset-password and /verify-email). In the documented deploy the server runs on
# Railway and the dashboard on Vercel (DIFFERENT origins), so emailed auth links
# MUST point at this web origin, NOT BASE_URL (the API/OAuth issuer). Optional for
# reset-only no-mail deploys; required when SMTP delivery or public signup is enabled.
# Example: https://app.3ngram.ai.
WEB_APP_URL=

# ── MCP browser origins (apps/server — issue #101)
# MCP_ALLOWED_ORIGINS: comma-separated EXTRA browser origins allowed to call /mcp.
# The MCP Streamable HTTP spec requires rejecting a present-but-invalid Origin
# (DNS-rebinding defense), so /mcp answers 403 to any Origin not on the allowlist.
# WEB_APP_URL is allowlisted automatically — set this only for ADDITIONAL origins.
# FAIL-CLOSED: with neither var set the allowlist is EMPTY and every request that
# carries an Origin is refused. That is safe for normal use — Claude Desktop, the
# CLI, and agent runtimes send NO Origin header and are unaffected — but a browser
# client needs its origin listed here.
# Local dev against MCP Inspector: MCP_ALLOWED_ORIGINS=http://localhost:6274
MCP_ALLOWED_ORIGINS=

# ── Auth token lifetimes & dev echo (apps/server)
# Optional — sane defaults apply when unset. SESSION_TTL_HOURS default 720 (30 days);
# RESET_TOKEN_TTL_MINUTES default 60; EMAIL_VERIFICATION_TOKEN_TTL_MINUTES default
# 1440 (24 hours).
SESSION_TTL_HOURS=
RESET_TOKEN_TTL_MINUTES=
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=
# DEV ONLY: when true, POST /auth/forgot-password returns the plaintext reset token
# in the 200 body so a developer with no mail channel can complete the flow. Boot
# REFUSES it outside NODE_ENV=development (the token is a credential — hard rule 6).
AUTH_RESET_TOKEN_DEV_ECHO=false
# Public signup is closed by default. When true, boot requires SMTP_HOST +
# SMTP_FROM + WEB_APP_URL so verification links can be delivered. The web app has
# its own THREENGRAM_SIGNUP_ENABLED display toggle; set both when opening signup.
AUTH_SIGNUP_ENABLED=false
# Screen new signup/reset passwords against the HIBP k-anonymity range API.
# Default off so self-host / restricted-egress deploys are unaffected; the check
# FAILS OPEN on timeout/unreachable (account availability outranks a best-effort
# screen), so enabling it never blocks account creation when the corpus is down.
PASSWORD_BREACH_CHECK_ENABLED=false

# ── SMTP for auth emails (apps/server — issues #267, #349; ALL optional)
# Set SMTP_HOST + SMTP_FROM together to send reset and verification emails (also
# requires WEB_APP_URL, enforced at boot). SMTP_USER/SMTP_PASS are optional (omit
# for an IP-allowlisted relay). SMTP_PASS is a credential — never logged. SMTP_PORT
# default 587. Unset = no mail server; forgot-password degrades to the dev-token
# path and public signup cannot be enabled.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Rate limiting (apps/server — docs/concepts/mcp-design.mdx)
# Shared Redis URL for cross-instance MCP rate limiting. OPTIONAL in dev/test
# (empty → in-memory limiter fallback); REQUIRED when NODE_ENV=production (an
# in-memory bucket per replica is no limit). The background worker always needs
# it. Hub alias: {DEV,STAGING,PROD}_3NGRAM_REDIS_URL maps to this REDIS_URL per
# Railway service; the dev value is intentionally blank.
REDIS_URL=

# ── Session closer (apps/worker — issue #166)
# Gates the session-sweep scheduler and closer job processors. False:
# scheduler removed, closer jobs no-op. Absent also means false, but an
# empty string is rejected by the stringbool schema — keep a real value.
SESSION_CLOSER_ENABLED=false

# ── Observability (packages/config)
# SENTRY_DSN is OPTIONAL in every environment (no production requirement). Empty =
# error tracking + tracing fully disabled (self-host default, no phone-home). Set
# per hosted service (hub alias {DEV,STAGING,PROD}_3NGRAM_SENTRY_DSN) to enable.
SENTRY_DSN=
# SENTRY_ENVIRONMENT tags events when a DSN is set. All hosted environments share
# one DSN, so set this per service (staging|production) to keep them
# distinguishable. Leave blank for self-host/local — it falls back to
# RAILWAY_ENVIRONMENT_NAME, then NODE_ENV.
SENTRY_ENVIRONMENT=
LOG_LEVEL=info
# Salt for hashed user_id in logs; required when NODE_ENV=production.
LOG_HASH_SALT=
# Raw memory content in debug logs; refuses to enable outside NODE_ENV=development.
LOG_DEBUG_CONTENT=false
# Release tag for error tracking. On Railway, RAILWAY_GIT_COMMIT_SHA is auto-injected
# and takes precedence; GIT_SHA is the manual override for other CI/CD platforms.
GIT_SHA=
NODE_ENV=development
