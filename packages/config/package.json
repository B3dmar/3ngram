{
  "name": "@3ngram/config",
  "version": "0.2.1",
  "description": "Env parsing, structured logger, request context, and observability bootstrap (docs/concepts/observability.mdx).",
  "license": "Apache-2.0",
  "homepage": "https://github.com/B3dmar/3ngram#readme",
  "bugs": {
    "url": "https://github.com/B3dmar/3ngram/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B3dmar/3ngram.git",
    "directory": "packages/config"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "default": "./dist/metrics.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "default": "./dist/otel.js"
    },
    "./redaction": {
      "types": "./dist/redaction.d.ts",
      "default": "./dist/redaction.js"
    },
    "./tsconfig.package.json": "./tsconfig.package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "tsconfig.package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/integration/**'"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@sentry/node": "10.56.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
