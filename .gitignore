node_modules/
dist/
.turbo/
coverage/
*.log
.env
.env.*
!.env.example
!.env.selfhost.example
.DS_Store
.worktrees/

# Vercel local project-link metadata (org/project ids); not source. Vercel recommends ignoring.
.vercel/

# LongMemEval-S full dataset cache (eval --download, issue #37): large +
# upstream-licensed; fetched on demand, NEVER committed.
eval/.cache/

# Per-run eval-nightly metrics (uploaded as a CI artifact, issue #37/#172).
# Ids/counts/scores only; written at job runtime, never committed.
eval-metrics/

# Local-only tooling workspace (never committed)
/tools/local/

# Relocated point-in-time reference material (pre-OSS migration artifacts):
# kept locally and in git history, dropped from the public tree.
/docs/research/private/

# Local AI-assistant and tooling context (kept on disk, never published).
CLAUDE.local.md
.claude/*
.agents/
.specify/
# Exception: the committed Claude Code cloud-session bootstrap (project settings +
# the SessionStart hook). No personal context, no secrets — toolchain setup only.
!.claude/settings.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/session-start.sh

# Local pnpm content-addressable store (created by `pnpm install --store-dir`);
# machine-local cache, never source.
.pnpm-store/

# Claude Code writes a mod's API declarations beside it at every load
# (plugins/<name>/.claude-plugin/types/); they belong to the installed build.
plugins/**/.claude-plugin/types/
# ...and a tsconfig.json extending them, for a mod without one of its own (the
# plugin's own config is tsconfig.spec.json).
plugins/*/tsconfig.json
