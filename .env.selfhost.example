# 3ngram self-host environment template.
#   cp .env.selfhost.example .env.selfhost   # then edit — never commit real values
#
# This enumerates EVERY variable the self-host core (server + datastore) reads,
# with its purpose and a safe default or example. It deliberately omits the
# hosted-only tooling in .env.example (Neon branch-per-PR CI keys, hosted Sentry
# aliases) — none of it is needed to self-host. Walkthrough:
# docs/self-host.mdx.

# ── Runtime mode ────────────────────────────────────────────────────────────
# Use `production` for a real deployment: it enforces the security-critical vars
# below (BASE_URL, OAUTH_JWKS, REDIS_URL, LOG_HASH_SALT) at boot instead of
# silently degrading. The compose stack supplies REDIS_URL for you.
NODE_ENV=production

# ── Datastore secrets (REQUIRED — no safe default; boot/compose refuse blanks) ─
# IMPORTANT: use URL-SAFE passwords. These values are interpolated into Postgres
# connection URLs (postgresql://user:PASSWORD@host/db), so characters with URL
# meaning (`/ ? # @ : % & + space` and quotes) will corrupt the URL and the
# server won't connect. Generate hex secrets, which are always safe:
#   openssl rand -hex 32
#
# POSTGRES_PASSWORD: superuser password for the bundled Postgres. Used by the
# one-shot migrations init (owner connection) only.
POSTGRES_PASSWORD=change-me-postgres-owner
# APP_USER_PASSWORD: password for the runtime role `app_user` (NOBYPASSRLS,
# append-only grants). compose derives the server's DATABASE_URL from this.
APP_USER_PASSWORD=change-me-app-user

# ── Database connection URLs — NOT keys here (single source of truth) ─────────
# DATABASE_URL and DATABASE_URL_UNPOOLED are deliberately NOT defined in this
# file: the password lives in exactly ONE place (POSTGRES_PASSWORD /
# APP_USER_PASSWORD above), and the URLs are built from it.
#   - The server builds its own DATABASE_URL from APP_USER_PASSWORD inside
#     compose.selfhost.yml (internal compose network).
#   - The optional host-run `pnpm seed` (API-key minting) builds both URLs from
#     the sourced passwords — see the quickstart, step 4:
#       export DATABASE_URL="postgresql://app_user:${APP_USER_PASSWORD}@localhost:54320/ngram"
#       export DATABASE_URL_UNPOOLED="postgresql://postgres:${POSTGRES_PASSWORD}@localhost:54320/ngram"
# DATABASE_URL_UNPOOLED must NOT become a key here: the server (which loads this
# file) refuses to boot in production if it is present in its environment.

# ── Server: public origin & OAuth (REQUIRED when NODE_ENV=production) ─────────
# BASE_URL: the deployment's public origin. Becomes the OAuth issuer and the
# RFC 8707 resource id (BASE_URL + /mcp); minted tokens' iss/aud must match it.
BASE_URL=http://localhost:3000
# OAUTH_JWKS: JSON array of RS256 PRIVATE signing keys (first = current signer).
# Generate one with:
#   node -e 'const{generateKeyPairSync,randomUUID}=require("crypto");const{privateKey}=generateKeyPairSync("rsa",{modulusLength:2048});const j=privateKey.export({format:"jwk"});j.kid="key-"+randomUUID().slice(0,8);j.alg="RS256";j.use="sig";console.log(JSON.stringify([j]))'
OAUTH_JWKS=

# ── Observability salt (REQUIRED when NODE_ENV=production) ────────────────────
# Salt for hashing user_id in logs so logs carry no raw identifiers.
LOG_HASH_SALT=change-me-random-salt
LOG_LEVEL=info

# ── Embeddings / LLM gateway (OPTIONAL) ──────────────────────────────────────
# Set BOTH to enable vector search. Either one unset = embeddings off and search
# returns 503 {"error":"embedding_unavailable"} (writes still succeed, with
# embedding deferred, and exact reads still work). Point these at your own
# gateway/proxy; nothing is sent anywhere by default.
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=

# ── Auth email (OPTIONAL) ────────────────────────────────────────────────────
# Leave unset for a single-user / API-key-only instance. Set SMTP_HOST +
# SMTP_FROM (and WEB_APP_URL) together to enable password-reset / verification
# email and public signup. SMTP_PASS is a credential — never logged.
WEB_APP_URL=
AUTH_SIGNUP_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Error tracking (OPTIONAL) ────────────────────────────────────────────────
# Empty = error tracking + tracing fully disabled (the self-host default; no
# phone-home). Set it to YOUR OWN Sentry DSN to send errors to your instance.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
